<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    <!--
        A single settings-list row, embedded via Settings.CreatePanelInitializer
        (the same mechanism Blizzard's own Nameplates settings page uses for its
        "NamePlate Preview" row). All child regions are built in Lua in the
        mixin's OnLoad, to keep the visual styling consistent with the rest of
        this addon (which is otherwise entirely Lua, no XML) rather than split
        across both languages.
    -->
    <Frame name="WhitePlayerHealthColorPreviewTemplate" mixin="WhitePlayerHealthColorPreviewMixin" virtual="true">
        <Size y="40"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
        </Scripts>
    </Frame>

    <!--
        A plain note row. Blizzard's only text-accepting settings helper is
        CreateSettingsListSectionHeaderInitializer, which renders as a bold
        section title - wrong weight for a hint sitting under one. The text is
        fixed, so this needs no mixin.
    -->
    <Frame name="WhitePlayerHealthSettingsNoteTemplate" virtual="true">
        <Size y="24"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Note" inherits="GameFontHighlightSmall" justifyH="LEFT"
                            text="Use /wph to move or resize the bar.">
                    <Anchors>
                        <Anchor point="LEFT" x="37" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>
</Ui>
